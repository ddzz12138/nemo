# Operator configuration. Never bundle this file or its filled values into Nemo Desktop.
# Use hosting secrets, HTTPS termination, a private listener, and persistent storage.
# Examples are placeholders, not live domains or credentials.
NEMO_REMOTE_ORIGIN=https://setup.example.com
NEMO_REMOTE_DATA_FILE=/var/lib/nemo-remote/state.json
NEMO_REMOTE_BIND=0.0.0.0
NEMO_REMOTE_PORT=8790

# Google web OAuth client. Authorized redirect URI:
# https://setup.example.com/auth/google/callback
NEMO_REMOTE_GOOGLE_CLIENT_ID=
NEMO_REMOTE_GOOGLE_CLIENT_SECRET=

# Scope token to Tunnel Edit in one account and DNS Edit in one owned zone.
NEMO_REMOTE_CF_ACCOUNT_ID=
NEMO_REMOTE_CF_ZONE_ID=
NEMO_REMOTE_CF_API_TOKEN=
NEMO_REMOTE_DOMAIN=example.com

# Pilot: invite verified Google emails, comma-separated.
NEMO_REMOTE_ALLOWED_EMAILS=
# Broader signup is disabled. Configure edge abuse controls before opting in.
NEMO_REMOTE_PUBLIC_SIGNUP=0
